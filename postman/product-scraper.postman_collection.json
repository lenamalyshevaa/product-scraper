          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://www.labirint.ru/books/1032572/\"\n}"
        }
      }
    },
    {
      "name": "Ещё одна книга",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/api/parse",
