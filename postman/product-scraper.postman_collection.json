{
  "info": {
    "name": "Product Scraper",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Результаты",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/answer"
      }
    },
    {
      "name": "Сортировка по цене",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/answer?sort=price&order=asc"
      }
    },
    {
      "name": "Фильтр: до 1000 руб, Лабиринт",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/answer?maxPrice=1000&site=labirint"
      }
    },
    {
      "name": "Поиск по названию",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/answer?q=дракула"
      }
    },
    {
      "name": "Вторая страница по 3",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/answer?sort=title&order=asc&page=1&size=3"
      }
    },
    {
      "name": "Вся история обходов",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/answer?latestOnly=false"
      }
    },
    {
      "name": "История цены по ссылке",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/answer/history?url=https://www.labirint.ru/books/982366/"
      }
    },
    {
      "name": "Одна книга",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/api/parse",
